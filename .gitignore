results/diag_k_oracle_vs_eigengap/*.npz

#journaux d'exécution des scripts (sortie console redirigée) : régénérés à chaque run
results/**/*.log

#secrets (jetons Hugging Face / GitHub : variables d'environnement uniquement)
.env
.env.*

#réglages locaux de Claude Code (propres à la machine)
.claude/settings.local.json

#démo : audio converti, uploads Gradio, exports RTTM (D-05)
demo/tmp/
.gradio/
